# .env.example — Copy this to .env and fill in real values
# DO NOT commit .env to git!

# Server
SERVER_PORT=8080

# PostgreSQL (Neon)
DATABASE_URL=jdbc:postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Resend Email
RESEND_API_KEY=re_your_api_key_here
RESEND_DOMAIN=yourdomain.com
